# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outfitexpert?schema=public"

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Tencent Cloud (COS / MPS)
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""
# 本地开发用 outfitexpert-temp-1521078213；线上生产用 outfithub-prod-1521078213（两个桶隔离）
TENCENT_COS_BUCKET=""
TENCENT_COS_REGION="ap-guangzhou"
TENCENT_MPS_REGION="ap-guangzhou"

# Email (SMTP，邮箱验证码登录用)
# QQ 邮箱：SMTP_HOST=smtp.qq.com，SMTP_PORT=465，SMTP_PASS 填「授权码」不是登录密码
# 163 邮箱：SMTP_HOST=smtp.163.com，SMTP_PORT=465
# Gmail：SMTP_HOST=smtp.gmail.com，SMTP_PORT=465，SMTP_PASS 填 App 专用密码
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Try-on
TRYON_DAILY_LIMIT="5"
